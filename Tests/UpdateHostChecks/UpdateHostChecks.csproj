<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>LexiFlow</AssemblyName>
    <TestVersion Condition="'$(TestVersion)' == ''">1.0.0</TestVersion>
    <TestCrash Condition="'$(TestCrash)' == ''">false</TestCrash>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="TestVersion" Value="$(TestVersion)" />
    <AssemblyMetadata Include="TestPublicKey" Value="$(TestPublicKey)" />
    <AssemblyMetadata Include="TestCrash" Value="$(TestCrash)" />
    <Compile Include="../../Application/LexiFlow/Updates/UpdateProtocol.cs" Link="UpdateProtocol.cs" />
    <Compile Include="../../Application/LexiFlow/Updates/UpdateFiles.cs" Link="UpdateFiles.cs" />
    <Compile Include="../../Application/LexiFlow/Updates/UpdateBootstrap.cs" Link="UpdateBootstrap.cs" />
  </ItemGroup>
</Project>
