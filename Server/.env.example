# Copy to .env (same folder as docker-compose.yml) and fill in real values.
# .env is gitignored — never commit real secrets here.

# Postgres 계정(worddb)의 비밀번호. 예전 SQL Server 구성의 DB_SA_PASSWORD에서 이름이 바뀌었다.
DB_PASSWORD=changeme-strong-password
NOTION_TOKEN=ntn_xxx
NOTION_WORDS_DATA_SOURCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Generate a random secret of at least 32 characters; do not use this placeholder.
ADMIN_TOKEN=
API_DOMAIN=lexiflow.duckdns.org
# Enable only for an approved migration after a verified database backup.
APPLY_MIGRATIONS=false

# Account verification/recovery SMTP. Never reuse a personal mailbox password.
# Keep disabled until the additive schema migration and real delivery test pass.
ACCOUNT_EMAIL_ENABLED=false
ACCOUNT_EMAIL_HOST=
ACCOUNT_EMAIL_PORT=587
ACCOUNT_EMAIL_USERNAME=
ACCOUNT_EMAIL_PASSWORD=
ACCOUNT_EMAIL_FROM=
