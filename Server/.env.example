# Copy to .env (same folder as docker-compose.yml) and fill in real values.
# .env is gitignored — never commit real secrets here.

# Postgres 계정(worddb)의 비밀번호. 예전 SQL Server 구성의 DB_SA_PASSWORD에서 이름이 바뀌었다.
DB_PASSWORD=changeme-strong-password
NOTION_TOKEN=ntn_xxx
NOTION_WORDS_DATA_SOURCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ADMIN_TOKEN=changeme-admin-token
