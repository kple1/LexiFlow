<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LexiFlow.Views.WordDetailView"
             Title="단어 상세">
    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Phone='20,24,20,60', Default='40,32,40,60'}"
                             Spacing="18"
                             HorizontalOptions="Fill"
                             MaximumWidthRequest="680">
            <Label Text="WORD DETAIL" Style="{StaticResource EyebrowLabel}"/>

            <Border Style="{StaticResource CardBorder}"
                    BackgroundColor="{StaticResource PrimarySoft}"
                    Stroke="{StaticResource Primary}"
                    Padding="{OnIdiom Phone=24, Default=34}">
                <VerticalStackLayout Spacing="13">
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                        <Label x:Name="englishLabel"
                               FontFamily="RobotoSerif"
                               FontSize="{OnIdiom Phone=38, Default=46}"
                               VerticalOptions="Center"/>
                        <Button Text="🔊"
                                FontSize="20"
                                Clicked="OnListenClick"
                                BackgroundColor="#33FFFFFF"
                                WidthRequest="48"
                                HeightRequest="48"
                                Padding="0"
                                CornerRadius="24"/>
                    </HorizontalStackLayout>
                    <Label x:Name="meaningLabel"
                           FontSize="20"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalTextAlignment="Center"/>
                    <Border x:Name="statusBadge"
                            IsVisible="False"
                            HorizontalOptions="Center"
                            Padding="10,4"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10">
                        <Label x:Name="statusLabel" FontSize="11" FontAttributes="Bold" TextColor="White"/>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border x:Name="speechErrorBorder"
                    IsVisible="False"
                    BackgroundColor="{StaticResource DangerSoft}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="13">
                <Label x:Name="speechErrorLabel" Style="{StaticResource MutedLabel}" TextColor="{StaticResource Danger}"/>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="EXAMPLE" Style="{StaticResource EyebrowLabel}"/>
                    <Label x:Name="exampleLabel" FontSize="17" LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Border>

            <Border x:Name="noteCard" Style="{StaticResource SoftCardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="MEMORY NOTE" Style="{StaticResource EyebrowLabel}" TextColor="{StaticResource Accent}"/>
                    <Label x:Name="noteLabel" Style="{StaticResource Body}" LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
