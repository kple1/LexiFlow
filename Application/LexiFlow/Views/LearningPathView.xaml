<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LexiFlow.Views.LearningPathView" Title="학습 코스">
    <ScrollView x:Name="courseScroll">
        <VerticalStackLayout Padding="18,18,18,24" Spacing="14" MaximumWidthRequest="1080" HorizontalOptions="Fill">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="학습 코스" Style="{StaticResource Title}"/>
                    <Label x:Name="progressLabel" Text="코스 불러오는 중" Style="{StaticResource MutedLabel}"/>
                </VerticalStackLayout>
                <Border Grid.Column="1" BackgroundColor="{StaticResource WarningSoft}" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="10,6" VerticalOptions="Center">
                    <Label x:Name="starsLabel" Text="★ 0" TextColor="{StaticResource Warning}" FontSize="13" FontAttributes="Bold"/>
                </Border>
            </Grid>
            <ProgressBar x:Name="courseProgress" Style="{StaticResource LearningProgressBar}" HeightRequest="4"/>
            <VerticalStackLayout Spacing="6">
                <Label x:Name="unitCountLabel" Text="유닛 불러오는 중" FontSize="12"
                       TextColor="{StaticResource TextSecondary}"/>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Button x:Name="previousUnitButton" Text="‹" FontSize="20" Padding="0"
                            WidthRequest="{OnIdiom Phone=44, Default=38}"
                            HeightRequest="{OnIdiom Phone=44, Default=38}"
                            Style="{StaticResource SecondaryButton}" IsEnabled="False"
                            Clicked="OnPreviousUnitClick" SemanticProperties.Description="이전 유닛 보기"/>
                    <Picker x:Name="unitPicker" Grid.Column="1" Style="{StaticResource AppPicker}"
                            IsEnabled="False" SelectedIndexChanged="OnUnitPickerChanged"
                            SemanticProperties.Description="전체 유닛 목록에서 바로 선택"/>
                    <Button x:Name="nextUnitButton" Grid.Column="2" Text="›" FontSize="20" Padding="0"
                            WidthRequest="{OnIdiom Phone=44, Default=38}"
                            HeightRequest="{OnIdiom Phone=44, Default=38}"
                            Style="{StaticResource SecondaryButton}" IsEnabled="False"
                            Clicked="OnNextUnitClick" SemanticProperties.Description="다음 유닛 보기"/>
                </Grid>
                <Grid ColumnDefinitions="*">
                    <ScrollView x:Name="unitTabsScroll" Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Always" VerticalScrollBarVisibility="Never"
                                HeightRequest="{OnIdiom Phone=62, Default=54}"
                                SizeChanged="OnUnitStripSizeChanged">
                        <HorizontalStackLayout x:Name="unitTabs" Spacing="6" Padding="0,0,0,12"/>
                    </ScrollView>
                </Grid>
            </VerticalStackLayout>
            <Grid x:Name="courseLayout" RowDefinitions="Auto,Auto" RowSpacing="14" ColumnSpacing="14">
                <Border x:Name="pathCard" Grid.Row="1" Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="unitEyebrow" Style="{StaticResource MutedLabel}"/>
                            <Label x:Name="unitProgressLabel" Grid.Column="1" Style="{StaticResource MutedLabel}"/>
                        </Grid>
                        <Label x:Name="unitTitle" FontSize="16" FontAttributes="Bold"/>
                        <Label x:Name="unitTip" Style="{StaticResource MutedLabel}"/>
                        <VerticalStackLayout x:Name="stageList" Spacing="6" Margin="0,2,0,0"/>
                    </VerticalStackLayout>
                </Border>
                <VerticalStackLayout x:Name="detailColumn" Spacing="14">
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="10">
                            <Label x:Name="selectedEyebrow" Text="선택한 단계" Style="{StaticResource MutedLabel}"/>
                            <Label x:Name="selectedTitle" Text="불러오는 중" FontSize="16" FontAttributes="Bold"/>
                            <Label x:Name="selectedDescription" Style="{StaticResource Body}"/>
                            <FlexLayout x:Name="wordChips" Wrap="Wrap"/>
                            <Label x:Name="selectedMeta" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                            <Button x:Name="continueButton" Text="학습 시작" Clicked="OnContinueClick" IsEnabled="False"/>
                            <Label x:Name="selectionHint" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                    </Border>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="추가 연습" FontSize="14" FontAttributes="Bold"/>
                        <Button Text="맞춤 복습" Style="{StaticResource SecondaryButton}" Clicked="OnReviewClick"/>
                        <Button Text="오답 복습" Style="{StaticResource SecondaryButton}" Clicked="OnMistakePracticeClick"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Text="어순 맞추기" FontSize="13" Style="{StaticResource GhostButton}" Clicked="OnArrangePracticeClick"/>
                            <Button Grid.Column="1" Text="문장 쓰기" FontSize="13" Style="{StaticResource GhostButton}" Clicked="OnWritingPracticeClick"/>
                        </Grid>
                        <Label Text="오답은 기기에 저장됩니다. 2회 연속 정답이면 복습 목록에서 제외됩니다." FontSize="12" TextColor="{StaticResource TextMuted}"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Grid>
            <Label x:Name="statusLabel" IsVisible="False" Style="{StaticResource MutedLabel}"/>
            <Button x:Name="retryButton" Text="다시 불러오기" IsVisible="False" Clicked="OnRetryClick" Style="{StaticResource GhostButton}"/>
            <ActivityIndicator x:Name="loading" IsRunning="False" IsVisible="False" Color="{StaticResource Primary}"/>
            <Label Text="첫 시도 정답률 90% 이상 ★★★ · 70% 이상 ★★ · 코스 기록은 이 기기에 저장됩니다."
                   FontSize="12" TextColor="{StaticResource TextMuted}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
