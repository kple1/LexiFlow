<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:LexiFlow.Converters"
             x:Class="LexiFlow.Views.IdiomView"
             Title="표현">
    <ContentPage.Resources>
        <conv:StatusColorConverter x:Key="StatusColor"/>
    </ContentPage.Resources>

    <Grid>
        <Grid RowDefinitions="Auto,Auto,Auto,*"
              RowSpacing="14"
              Padding="{OnIdiom Phone='20,20,20,56', Default='24,20,24,40'}"
              HorizontalOptions="Fill"
              MaximumWidthRequest="900">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <VerticalStackLayout Spacing="4">
                    <Label Text="표현" Style="{StaticResource Title}"/>
                    <Label Text="분류별 표현의 뜻과 쓰임" Style="{StaticResource Body}"/>
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="복습 시작" VerticalOptions="Center" BackgroundColor="{StaticResource Primary}" Clicked="OnQuizClick"/>
            </Grid>

            <Picker Grid.Row="1"
                    SemanticProperties.Description="표현 카테고리"
                    ItemsSource="{Binding Categories}"
                    SelectedItem="{Binding SelectedCategory}"
                    Style="{StaticResource AppPicker}"/>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                <Label Text="{Binding ResultSummary}" Style="{StaticResource MutedLabel}" VerticalOptions="Center"/>
                <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}"/>
            </Grid>

            <Grid Grid.Row="3">
                <CollectionView ItemsSource="{Binding FilteredIdioms}" SelectionMode="None" IsVisible="{Binding IsNotBusy}">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" Spacing="10" Padding="20">
                            <Label Text="해당 카테고리의 표현이 없습니다." Style="{StaticResource SubTitle}" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ShowIdiomDetailCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6" ColumnSpacing="12">
                                    <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" LineBreakMode="TailTruncation"/>
                                    <Border Grid.Column="1" IsVisible="{Binding HasUserStatus}" VerticalOptions="Center" Padding="9,3" StrokeThickness="0" BackgroundColor="{Binding UserStatus, Converter={StaticResource StatusColor}}" StrokeShape="RoundRectangle 6">
                                        <Label Text="{Binding UserStatus}" FontSize="10" FontAttributes="Bold" TextColor="White"/>
                                    </Border>
                                    <HorizontalStackLayout Grid.Row="1" Spacing="7">
                                        <Label Text="{Binding Category}" Style="{StaticResource MutedLabel}" TextColor="{StaticResource Primary}"/>
                                        <Label Text="· 상세 보기" Style="{StaticResource MutedLabel}"/>
                                    </HorizontalStackLayout>
                                    <Label Grid.Row="1" Grid.Column="1" Text="›" FontSize="24" TextColor="{StaticResource TextMuted}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Border IsVisible="{Binding HasError}" BackgroundColor="{StaticResource DangerSoft}" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="14" VerticalOptions="Start">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"/>
                        <Button Text="다시 시도" Command="{Binding LoadIdiomsCommand}" Style="{StaticResource SecondaryButton}"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>

        <Grid IsVisible="{Binding IsDetailVisible}" BackgroundColor="#D9171717">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseDetailCommand}"/>
            </Grid.GestureRecognizers>
            <Border Style="{StaticResource CardBorder}"
                    Padding="14"
                    Margin="20"
                    MaximumWidthRequest="560"
                    MaximumHeightRequest="680"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer/>
                </Border.GestureRecognizers>
                <ScrollView>
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="표현 자세히" Style="{StaticResource SubTitle}" TextColor="{StaticResource Primary}" VerticalOptions="Center"/>
                            <Button Grid.Column="1" Text="×" Command="{Binding CloseDetailCommand}" Style="{StaticResource GhostButton}" WidthRequest="{OnIdiom Phone=44, Default=36}" Padding="0" FontSize="20"/>
                        </Grid>
                        <Label Text="{Binding SelectedIdiom.Title}" FontSize="22" FontAttributes="Bold"/>
                        <Border BackgroundColor="{StaticResource PrimarySoft}" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="10,5" HorizontalOptions="Start">
                            <Label Text="{Binding SelectedIdiom.Category}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                        </Border>
                        <BoxView HeightRequest="1" Color="{StaticResource Stroke}"/>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="뜻과 쓰임" Style="{StaticResource EyebrowLabel}" TextColor="{StaticResource Primary}"/>
                            <Label Text="{Binding SelectedIdiom.Explanation}" Style="{StaticResource Body}" TextColor="{StaticResource TextPrimary}" LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="예문" Style="{StaticResource EyebrowLabel}"/>
                            <Label Text="{Binding SelectedIdiom.Example}" FontSize="14" LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                        <Border BackgroundColor="{StaticResource SurfaceMuted}" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="13">
                            <Label Text="{Binding SelectedIdiom.Note}" Style="{StaticResource MutedLabel}" LineBreakMode="WordWrap"/>
                        </Border>
                        <Button Text="닫기" Command="{Binding CloseDetailCommand}" BackgroundColor="{StaticResource Primary}"/>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
