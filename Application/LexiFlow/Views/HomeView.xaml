<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LexiFlow.Views.HomeView"
             Title="오늘">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="{OnIdiom Phone='16,20,16,80', Default='28,24,28,48'}"
                                 Spacing="18"
                                 HorizontalOptions="Fill"
                                 MaximumWidthRequest="1040">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="greetingLabel" Text="오늘" Style="{StaticResource Title}"/>
                        <Label x:Name="motivationLabel"
                               Text="오늘 0문제 완료 · 일일 목표 10문제"
                               Style="{StaticResource MutedLabel}"/>
                    </VerticalStackLayout>
                    <Label x:Name="headerXpLabel"
                           Grid.Column="1"
                           Text="누적 0 XP"
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}"
                           VerticalOptions="Center"/>
                </Grid>

                <Border x:Name="errorBorder"
                        IsVisible="False"
                        BackgroundColor="{StaticResource DangerSoft}"
                        Stroke="{StaticResource Danger}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 6"
                        Padding="12,10">
                    <Label x:Name="errorLabel"
                           Text="학습 현황을 불러오지 못했습니다."
                           FontSize="13"
                           TextColor="{StaticResource TextPrimary}"/>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                <Label Text="일일 목표" Style="{StaticResource MutedLabel}"/>
                                <Label x:Name="goalMessageLabel"
                                       Text="오늘의 학습"
                                       FontSize="16"
                                       FontAttributes="Bold"/>
                            </VerticalStackLayout>
                            <Button x:Name="primaryActionButton"
                                    Grid.Column="1"
                                    Text="학습 시작"
                                    WidthRequest="{OnIdiom Phone=108, Default=132}"
                                    VerticalOptions="Center"
                                    Clicked="OnStartWordReviewClick"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                            <ProgressBar x:Name="goalProgress"
                                         Style="{StaticResource LearningProgressBar}"
                                         ProgressColor="{StaticResource Primary}"
                                         VerticalOptions="Center"/>
                            <Label x:Name="goalProgressLabel"
                                   Grid.Column="1"
                                   Text="0 / 10"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="14">
                        <Grid x:Name="statsGrid"
                              RowDefinitions="Auto,Auto"
                              ColumnDefinitions="*,*,*,*"
                              RowSpacing="16"
                              ColumnSpacing="12">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="StatsLayoutStates">
                                    <VisualState x:Name="WideStats">
                                        <VisualState.StateTriggers>
                                            <AdaptiveTrigger MinWindowWidth="760"/>
                                        </VisualState.StateTriggers>
                                        <VisualState.Setters>
                                            <Setter Property="RowSpacing" Value="0"/>
                                            <Setter TargetName="streakStat" Property="Grid.ColumnSpan" Value="1"/>
                                            <Setter TargetName="dueStat" Property="Grid.Column" Value="1"/>
                                            <Setter TargetName="dueStat" Property="Grid.ColumnSpan" Value="1"/>
                                            <Setter TargetName="masteredStat" Property="Grid.Row" Value="0"/>
                                            <Setter TargetName="masteredStat" Property="Grid.Column" Value="2"/>
                                            <Setter TargetName="masteredStat" Property="Grid.ColumnSpan" Value="1"/>
                                            <Setter TargetName="levelStat" Property="Grid.Row" Value="0"/>
                                            <Setter TargetName="levelStat" Property="Grid.Column" Value="3"/>
                                            <Setter TargetName="levelStat" Property="Grid.ColumnSpan" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CompactStats">
                                        <VisualState.StateTriggers>
                                            <AdaptiveTrigger MinWindowWidth="0"/>
                                        </VisualState.StateTriggers>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <VerticalStackLayout x:Name="streakStat" Grid.ColumnSpan="2" Spacing="4">
                                <Label Text="연속 학습" Style="{StaticResource MutedLabel}"/>
                                <Label x:Name="streakLabel" Text="0일" Style="{StaticResource StatValueLabel}" HorizontalTextAlignment="Start"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="dueStat" Grid.Column="2" Grid.ColumnSpan="2" Spacing="4">
                                <Label Text="복습 대기" Style="{StaticResource MutedLabel}"/>
                                <Label x:Name="dueLabel" Text="0개" Style="{StaticResource StatValueLabel}" HorizontalTextAlignment="Start"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="masteredStat" Grid.Row="1" Grid.ColumnSpan="2" Spacing="4">
                                <Label Text="학습 완료" Style="{StaticResource MutedLabel}"/>
                                <Label x:Name="masteredLabel" Text="0개" Style="{StaticResource StatValueLabel}" HorizontalTextAlignment="Start"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="levelStat" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Spacing="4">
                                <Label Text="현재 레벨" Style="{StaticResource MutedLabel}"/>
                                <Label x:Name="levelStatLabel" Text="1" Style="{StaticResource StatValueLabel}" HorizontalTextAlignment="Start"/>
                                <Label x:Name="levelRemainLabel" Text="다음까지 200 XP" FontSize="12" TextColor="{StaticResource TextMuted}"/>
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource Stroke}"/>
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8">
                            <Label x:Name="levelLabel" Text="레벨 1" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                            <Label x:Name="levelXpLabel" Grid.Column="1" Text="0 / 200 XP" FontSize="12" TextColor="{StaticResource TextMuted}"/>
                            <ProgressBar x:Name="levelProgress"
                                         Grid.Row="1"
                                         Grid.ColumnSpan="2"
                                         Style="{StaticResource LearningProgressBar}"
                                         ProgressColor="{StaticResource Primary}"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="10">
                    <Label Text="학습 목록" Style="{StaticResource SubTitle}"/>
                    <Border Style="{StaticResource CardBorder}" Padding="14,0">
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,12">
                                <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                    <Label Text="문장 학습" FontSize="14" FontAttributes="Bold"/>
                                    <Label x:Name="wordDueLabel" Text="복습 단어 확인 중" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="열기" Style="{StaticResource SecondaryButton}" VerticalOptions="Center" Clicked="OnStartWordReviewClick"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource Stroke}"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,12">
                                <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                    <Label Text="문법 복습" FontSize="14" FontAttributes="Bold"/>
                                    <Label x:Name="grammarDueLabel" Text="복습 문법 확인 중" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="열기" Style="{StaticResource SecondaryButton}" VerticalOptions="Center" Clicked="OnStartGrammarReviewClick"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource Stroke}"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,12">
                                <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                    <Label Text="표현 복습" FontSize="14" FontAttributes="Bold"/>
                                    <Label x:Name="idiomDueLabel" Text="복습 표현 확인 중" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="열기" Style="{StaticResource SecondaryButton}" VerticalOptions="Center" Clicked="OnStartIdiomReviewClick"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="loadingOverlay"
              IsVisible="False"
              BackgroundColor="#99171717">
            <ActivityIndicator IsRunning="True"
                               Color="{StaticResource Primary}"
                               WidthRequest="28"
                               HeightRequest="28"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
        </Grid>
    </Grid>
</ContentPage>
