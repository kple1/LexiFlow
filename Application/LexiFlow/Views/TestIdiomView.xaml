<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LexiFlow.Views.TestIdiomView"
             Title="표현 복습">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="{OnIdiom Phone='20,20,20,56', Default='24,20,24,40'}"
                                 Spacing="14"
                                 HorizontalOptions="Fill"
                                 MaximumWidthRequest="720">
                <VerticalStackLayout Spacing="4">
                    <Label Text="표현 복습" Style="{StaticResource Title}" FontSize="22"/>
                    <Label Text="상황을 떠올리고 자연스러운 쓰임을 확인하세요." Style="{StaticResource Body}"/>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="quizPanel" IsVisible="False" Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <ProgressBar x:Name="sessionProgress" Style="{StaticResource LearningProgressBar}" VerticalOptions="Center" ProgressColor="{StaticResource Primary}"/>
                        <Label x:Name="counterLabel" Grid.Column="1" Text="1 / 10" Style="{StaticResource MutedLabel}" FontAttributes="Bold"/>
                    </Grid>

                    <Border Style="{StaticResource CardBorder}" Padding="14">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label x:Name="categoryLabel" Text="표현" Style="{StaticResource EyebrowLabel}" TextColor="{StaticResource Primary}"/>
                                <Label x:Name="sessionXpLabel" Grid.Column="1" Text="+0 XP" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                            </Grid>
                            <Label x:Name="titleLabel"
                                   Text="표현"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,2"/>
                            <Button x:Name="showButton" Text="뜻과 예문 확인" Clicked="OnShowClick" Margin="0,8,0,0" BackgroundColor="{StaticResource Primary}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="answerPanel" IsVisible="False" Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="14">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="뜻과 쓰임" Style="{StaticResource EyebrowLabel}" TextColor="{StaticResource Primary}"/>
                                <Label x:Name="explanationLabel" Style="{StaticResource Body}" TextColor="{StaticResource TextPrimary}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                            <BoxView HeightRequest="1" Color="{StaticResource Stroke}"/>
                            <VerticalStackLayout Spacing="5">
                                <Label Text="예문" Style="{StaticResource EyebrowLabel}"/>
                                <Label x:Name="exampleLabel" FontSize="14" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                            <Border x:Name="noteBorder" BackgroundColor="{StaticResource SurfaceMuted}" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="13">
                                <Label x:Name="noteLabel" Style="{StaticResource MutedLabel}" LineBreakMode="WordWrap"/>
                            </Border>
                            <Label Text="뜻과 쓰임을 기억했나요?" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" Margin="0,4,0,0"/>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button Grid.Column="0" Text="다시 보기" Style="{StaticResource SecondaryButton}" Clicked="OnAgainClick"/>
                                <Button Grid.Column="1" Text="기억함" Clicked="OnGotItClick" BackgroundColor="{StaticResource Primary}"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Border x:Name="donePanel" IsVisible="False" Style="{StaticResource CardBorder}" Padding="14">
                    <VerticalStackLayout Spacing="14">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="표현 복습 완료" Style="{StaticResource Title}" FontSize="22" HorizontalTextAlignment="Center"/>
                            <Label x:Name="doneMessageLabel" Text="이번 복습 결과" Style="{StaticResource Body}" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                <Label x:Name="scoreLabel" Text="0 / 0" Style="{StaticResource StatValueLabel}"/>
                                <Label Text="첫 시도 기억" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label x:Name="earnedXpLabel" Text="+0 XP" Style="{StaticResource StatValueLabel}" TextColor="{StaticResource Warning}"/>
                                <Label Text="획득 경험치" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                        <Button Text="한 번 더 복습" Clicked="OnRestartClick" BackgroundColor="{StaticResource Primary}"/>
                        <Button Text="오늘 화면으로" Style="{StaticResource SecondaryButton}" Clicked="OnHomeClick"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="loadingOverlay" BackgroundColor="#B3171717">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="True" Color="{StaticResource Primary}" WidthRequest="28" HeightRequest="28"/>
                <Label Text="복습 준비 중" Style="{StaticResource MutedLabel}"/>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
