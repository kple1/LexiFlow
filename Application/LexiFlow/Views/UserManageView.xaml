<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:LexiFlow.Views.UserControls"
             x:Class="LexiFlow.Views.UserManageView"
             Title="LexiFlow"
             BackgroundColor="{StaticResource AppBackground}">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24"
                                 Spacing="20"
                                 MaximumWidthRequest="420"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <VerticalStackLayout Spacing="6">
                    <Label Text="LexiFlow" Style="{StaticResource Title}"/>
                    <Label Text="단어 · 문장 · 복습" Style="{StaticResource Body}"/>
                </VerticalStackLayout>
                <Border Style="{StaticResource CardBorder}" Padding="18">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="로그인" Style="{StaticResource SubTitle}"/>

                        <VerticalStackLayout Spacing="7">
                            <Label Text="아이디" Style="{StaticResource EyebrowLabel}"/>
                            <Entry Placeholder="아이디 입력"
                                   Style="{StaticResource FieldEntry}"
                                   Text="{Binding UserId}"
                                   ReturnType="Next"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="7">
                            <Label Text="비밀번호" Style="{StaticResource EyebrowLabel}"/>
                            <Entry Placeholder="비밀번호 입력"
                                   Style="{StaticResource FieldEntry}"
                                   IsPassword="True"
                                   Text="{Binding Password}"
                                   ReturnType="Go"
                                   Completed="OnPasswordCompleted"/>
                        </VerticalStackLayout>

                        <Border x:Name="messageCard" IsVisible="False"
                                StrokeThickness="0" Padding="12,9"
                                StrokeShape="RoundRectangle 6">
                            <Label x:Name="messageLabel" FontSize="13" LineBreakMode="WordWrap"/>
                        </Border>

                        <Button Text="로그인"
                                Style="{StaticResource PrimaryButton}"
                                IsEnabled="{Binding IsNotBusy}"
                                Clicked="OnSignInClick"/>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Text="비밀번호 찾기"
                                    Style="{StaticResource GhostButton}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Clicked="OnForgotPasswordClick"/>
                            <Button Grid.Column="1" Text="계정 만들기"
                                    Style="{StaticResource GhostButton}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Clicked="OnSignUpClick"/>
                        </Grid>
                        <Label Text="가입과 비밀번호 복구는 브라우저에서 진행합니다."
                               Style="{StaticResource MutedLabel}" FontSize="12"/>
                    </VerticalStackLayout>
                </Border>

                <controls:AppUpdatePanel/>
            </VerticalStackLayout>
        </ScrollView>

        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#66171717">
            <Border Style="{StaticResource CardBorder}"
                    HorizontalOptions="Center" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="12">
                    <ActivityIndicator IsRunning="True" Color="{StaticResource Primary}"/>
                    <Label Text="연결 중…" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
