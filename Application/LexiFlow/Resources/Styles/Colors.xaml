<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Neutral graphite with one restrained copper accent. -->
    <Color x:Key="AppBackground">#171717</Color>
    <Color x:Key="AppBackgroundSoft">#1A1A1A</Color>
    <Color x:Key="Surface">#202020</Color>
    <Color x:Key="SurfaceElevated">#282828</Color>
    <Color x:Key="SurfaceMuted">#1C1C1C</Color>
    <Color x:Key="Stroke">#343434</Color>

    <Color x:Key="Primary">#D6AD7B</Color>
    <Color x:Key="PrimaryDark">#BB9161</Color>
    <Color x:Key="PrimarySoft">#302B24</Color>
    <Color x:Key="PrimaryContrast">#171717</Color>
    <Color x:Key="Accent">#D6AD7B</Color>
    <Color x:Key="Success">#91B09A</Color>
    <Color x:Key="SuccessSoft">#26312A</Color>
    <Color x:Key="Warning">#D6AD7B</Color>
    <Color x:Key="WarningSoft">#342D23</Color>
    <Color x:Key="Danger">#D68A8A</Color>
    <Color x:Key="DangerSoft">#38282A</Color>

    <Color x:Key="TextPrimary">#E7E5E1</Color>
    <Color x:Key="TextSecondary">#A3A3A0</Color>
    <Color x:Key="TextMuted">#8C8C88</Color>
</ResourceDictionary>
