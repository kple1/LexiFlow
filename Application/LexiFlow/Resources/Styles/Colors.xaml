<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- LexiFlow dark learning palette -->
    <Color x:Key="AppBackground">#0B1120</Color>
    <Color x:Key="AppBackgroundSoft">#10182B</Color>
    <Color x:Key="Surface">#151F35</Color>
    <Color x:Key="SurfaceElevated">#1C2942</Color>
    <Color x:Key="SurfaceMuted">#111A2C</Color>
    <Color x:Key="Stroke">#2A3A58</Color>

    <Color x:Key="Primary">#5B8CFF</Color>
    <Color x:Key="PrimaryDark">#3E6FE8</Color>
    <Color x:Key="PrimarySoft">#20345F</Color>
    <Color x:Key="Accent">#A78BFA</Color>
    <Color x:Key="Success">#22C55E</Color>
    <Color x:Key="SuccessSoft">#163A2A</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="WarningSoft">#3B2B15</Color>
    <Color x:Key="Danger">#FB7185</Color>
    <Color x:Key="DangerSoft">#45202B</Color>

    <Color x:Key="TextPrimary">#F8FAFC</Color>
    <Color x:Key="TextSecondary">#A7B2C7</Color>
    <Color x:Key="TextMuted">#71809B</Color>
</ResourceDictionary>
