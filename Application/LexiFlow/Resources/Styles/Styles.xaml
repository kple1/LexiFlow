<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{StaticResource AppBackground}"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>

    <Style TargetType="Label" x:Key="Title">
        <Setter Property="FontFamily" Value="RobotoSerif"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
    </Style>

    <Style TargetType="Label" x:Key="SubTitle">
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
    </Style>

    <Style TargetType="Label" x:Key="Body">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
    </Style>

    <Style TargetType="Label" x:Key="EyebrowLabel">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="CharacterSpacing" Value="1.3"/>
        <Setter Property="TextColor" Value="{StaticResource Primary}"/>
    </Style>

    <Style TargetType="Label" x:Key="MutedLabel">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
    </Style>

    <Style TargetType="Label" x:Key="StatValueLabel">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
        <Setter Property="HorizontalTextAlignment" Value="Center"/>
    </Style>

    <Style TargetType="Border" x:Key="CardBorder">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}"/>
        <Setter Property="Stroke" Value="{StaticResource Stroke}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 18"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <Style TargetType="Border" x:Key="SoftCardBorder" BasedOn="{StaticResource CardBorder}">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceMuted}"/>
        <Setter Property="StrokeThickness" Value="0"/>
    </Style>

    <Style TargetType="Entry" x:Key="FieldEntry">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceMuted}"/>
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
        <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="HeightRequest" Value="52"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <Style TargetType="Picker" x:Key="AppPicker">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceMuted}"/>
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
        <Setter Property="TitleColor" Value="{StaticResource TextSecondary}"/>
        <Setter Property="HeightRequest" Value="50"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="HeightRequest" Value="50"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
        <Setter Property="TextColor" Value="White"/>
    </Style>

    <Style TargetType="Button" x:Key="PrimaryButton">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
        <Setter Property="TextColor" Value="White"/>
    </Style>

    <Style TargetType="Button" x:Key="SecondaryButton">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceElevated}"/>
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderColor" Value="{StaticResource Stroke}"/>
        <Setter Property="BorderWidth" Value="1"/>
    </Style>

    <Style TargetType="Button" x:Key="GhostButton">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
        <Setter Property="BorderColor" Value="{StaticResource Stroke}"/>
        <Setter Property="BorderWidth" Value="1"/>
    </Style>

    <Style TargetType="Button" x:Key="DangerButton">
        <Setter Property="BackgroundColor" Value="{StaticResource DangerSoft}"/>
        <Setter Property="TextColor" Value="{StaticResource Danger}"/>
    </Style>

    <Style TargetType="ProgressBar" x:Key="LearningProgressBar">
        <Setter Property="ProgressColor" Value="{StaticResource Primary}"/>
        <Setter Property="HeightRequest" Value="9"/>
    </Style>

</ResourceDictionary>
